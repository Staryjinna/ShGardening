---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ExploreTiles from '../components/ExploreTiles.astro';
import CtaBand from '../components/CtaBand.astro';
import Reels from '../components/Reels.astro';
import { contact } from '../data/contact';
---
<Base
  title="Landscaping & Garden Design in Coimbatore | Vanascape Gardens"
  description="Vanascape Gardens: landscaping and garden design in Coimbatore. Mexican grass and pearl grass lawns, Bangalore stone work, courtyards, pebble paths and garden maintenance. Free site visit."
  path="/"
>
  <Hero />
  <TrustStrip />
  <ExploreTiles />
  {contact.instagram.url && <Reels />}
  <CtaBand />
</Base>
