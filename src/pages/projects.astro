---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import Icons from '../components/Icons.astro';
import { projects, categories, galleryNote } from '../data/projects';
import { waLink } from '../lib/links';
---
<Base
  title="Garden Projects in Coimbatore: Lawns, Stone Work, Courtyards | Vanascape Gardens"
  description="Browse garden design photos from Vanascape Gardens: lawns, stone pathways, courtyard gardens and tropical planting in Coimbatore."
  path="/projects/"
>
  <PageHeader eyebrow="Our work" title="Garden styles" intro="Modern modular and traditional gardens: lawns, stone pathways, courtyards and planting." />
  <section class="section dots">
    <div class="container-x">

      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects" id="filters">
        {categories.map((c, i) => (
          <button type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border-2 border-forest-700 px-4 py-2 text-sm font-bold text-forest-700 transition aria-pressed:bg-forest-700 aria-pressed:text-white">{c.label}</button>
        ))}
      </div>
      <p id="filter-status" class="sr-only" aria-live="polite"></p>

      <div class="mt-8" id="gallery"><PhotoGrid items={projects} group="all" /></div>
      {galleryNote && <p class="mt-4 text-sm text-granite-700">{galleryNote}</p>}

      <div class="mt-14 rounded-2xl bg-forest-800 p-8 text-center text-white on-dark">
        <h2 class="text-2xl font-semibold">Like what you see?</h2>
        <p class="mt-2 text-white/85">Message us for a free site visit and quote.</p>
        <a href={waLink('Hello Vanascape Gardens, I saw your projects and would like a free site visit.')} target="_blank" rel="noopener" class="btn btn-wa mt-5"><Icons name="whatsapp" /> WhatsApp for a free site visit</a>
      </div>
    </div>
  </section>
  <Lightbox />
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#gallery [data-cat]');
  const status = document.getElementById('filter-status')!;
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((li) => {
        const show = f === 'all' || (li.dataset.cat || '').split(' ').includes(f || '');
        li.hidden = !show;
        if (show) n++;
      });
      status.textContent = `${n} projects shown`;
    }),
  );
  const preset = new URLSearchParams(location.search).get('style');
  if (preset) document.querySelector<HTMLButtonElement>(`[data-filter="${preset}"]`)?.click();
</script>
