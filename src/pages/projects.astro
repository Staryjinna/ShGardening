---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import Icons from '../components/Icons.astro';
import { projects, categories } from '../data/projects';
import { taglines } from '../data/taglines';
import { waLink } from '../lib/links';
---
<Base
  title="Garden Projects in Kerala: Lawns, Stone Work, Courtyards | Sreehari Gardens"
  description="Browse garden design projects by Sreehari Gardens: pearl grass and Mexican grass lawns, Bangalore stone pathways, courtyard gardens and tropical planting across Kerala."
  path="/projects/"
>
  <section class="section stone-grid">
    <div class="container-x">
      <p class="eyebrow">Projects</p>
      <h1 class="mt-2 text-4xl font-semibold text-navy-800 sm:text-5xl">Our garden projects</h1>
      <p class="mt-3 max-w-2xl text-granite-700"><span lang="ml" class="font-semibold">{taglines.courtyard.ml}</span> <span class="text-sm">({taglines.courtyard.en})</span></p>

      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects" id="filters">
        {categories.map((c, i) => (
          <button type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border-2 border-navy-700 px-4 py-2 text-sm font-bold text-navy-700 transition aria-pressed:bg-navy-700 aria-pressed:text-white">{c.label}</button>
        ))}
      </div>
      <p id="filter-status" class="sr-only" aria-live="polite"></p>

      <div class="mt-8" id="gallery"><PhotoGrid items={projects} group="all" /></div>

      <div class="mt-14 rounded-2xl bg-navy-800 p-8 text-center text-white on-dark">
        <h2 class="text-2xl font-semibold">Like what you see?</h2>
        <p class="mt-2 text-white/85">Message us for a free site visit and quote.</p>
        <a href={waLink('Hello Sreehari Gardens, I saw your projects and would like a free site visit.')} target="_blank" rel="noopener" class="btn btn-wa mt-5"><Icons name="whatsapp" /> WhatsApp for a free site visit</a>
      </div>
    </div>
  </section>
  <Lightbox />
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#gallery [data-cat]');
  const status = document.getElementById('filter-status')!;
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((li) => {
        const show = f === 'all' || li.dataset.cat === f;
        li.hidden = !show;
        if (show) n++;
      });
      status.textContent = `${n} projects shown`;
    }),
  );
</script>
