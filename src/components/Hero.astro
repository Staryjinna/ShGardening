---
import Icons from './Icons.astro';
import Logo from './Logo.astro';
import { contact } from '../data/contact';
import { waLink } from '../lib/links';
---
<section class="on-dark relative isolate overflow-hidden bg-forest-800 text-white">
  <div class="dots-light absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-x grid items-center gap-10 py-16 lg:grid-cols-[1.25fr_1fr] lg:py-28">
    <div>
      <p class="eyebrow">{contact.city} · Landscaping &amp; Gardening</p>
      <h1 class="h-display mt-4 text-5xl sm:text-6xl lg:text-7xl">Gardens designed for {contact.city} homes</h1>
      <p class="mt-6 max-w-xl text-lg text-white/90">Lawns, stone pathways, courtyards, planters and year-round garden maintenance, led by {contact.owner}.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={waLink('Hello Vanascape Gardens, I would like a free site visit.')} target="_blank" rel="noopener" class="btn btn-wa"><Icons name="whatsapp" /> WhatsApp for a free site visit</a>
        <a href="/services/" class="btn btn-ghost">Explore our services</a>
      </div>
    </div>
    <div class="relative hidden justify-self-center lg:block" aria-hidden="true">
      <div class="absolute -right-6 -top-6 h-40 w-40 rounded-full bg-clay-500/90"></div>
      <div class="relative rounded-[2rem] bg-cream p-3 shadow-2xl"><Logo size={340} variant="full" priority /></div>
    </div>
  </div>
</section>
