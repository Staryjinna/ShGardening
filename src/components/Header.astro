---
import Logo from './Logo.astro';
import Icons from './Icons.astro';
import { contact } from '../data/contact';
import { waLink } from '../lib/links';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-granite-100 bg-cream/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-3" aria-label={`${contact.brand} home`}>
      <Logo size={44} priority />
      <span class="font-display text-2xl font-bold leading-none text-forest-800">{contact.brand}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {nav.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
           class:list={['rounded-lg px-4 py-2 font-medium transition', isActive(n.href) ? 'bg-forest-700 text-white' : 'text-granite-700 hover:bg-sage-100']}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={waLink('Hello Vanascape Gardens, I would like to know more about your services.')} class="btn btn-wa hidden !px-4 !py-2 lg:inline-flex" target="_blank" rel="noopener">
        <Icons name="whatsapp" class="h-5 w-5" /> WhatsApp us
      </a>
      <button type="button" id="menu-btn" class="grid h-11 w-11 place-items-center rounded-lg text-forest-800 md:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <Icons name="menu" class="h-7 w-7" />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-granite-100 bg-cream md:hidden">
    <ul class="container-x grid gap-2 py-3">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
          class:list={['block rounded-xl px-4 py-3 text-lg font-medium', isActive(n.href) ? 'bg-forest-700 text-white' : 'bg-white ring-1 ring-granite-100']}>{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn')!;
  const panel = document.getElementById('mobile-nav')!;
  const set = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn.addEventListener('click', () => set(panel.classList.contains('hidden')));
</script>
