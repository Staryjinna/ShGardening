---
import { services, quoteMessage } from '../data/services';
import { waLink } from '../lib/links';
const data = services.map((s) => ({ id: s.id, name: s.name, description: s.description, highlights: s.highlights ?? [], wa: waLink(quoteMessage(s)) }));
---
<section class="section dots">
  <div class="container-x">
    <p class="eyebrow">Tap a service for details</p>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <li class="reveal">
          <button type="button" class="tile-btn h-full" data-service={s.id} aria-haspopup="dialog">
            <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-3xl font-bold">{s.name}</span>
            <span class="tile-sub">{s.summary}</span>
            <span class="tile-go">View details +</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-granite-700"><strong>Every project starts with a free site visit.</strong> Message us and we will guide you.</p>
  </div>
</section>

<dialog id="svc-dialog" class="sheet" aria-labelledby="svc-title">
  <div class="p-7">
    <h2 id="svc-title" class="font-display text-4xl font-bold text-forest-800"></h2>
    <p id="svc-desc" class="mt-3 text-granite-700"></p>
    <ul id="svc-points" class="mt-4 space-y-2 font-medium text-sage-700"></ul>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a id="svc-wa" href="#" target="_blank" rel="noopener" class="btn btn-wa flex-1">Ask on WhatsApp</a>
      <button type="button" id="svc-close" class="btn btn-outline flex-1">Close</button>
    </div>
  </div>
</dialog>
<script id="svc-data" type="application/json" set:html={JSON.stringify(data)} />
<script>
  const data = JSON.parse(document.getElementById('svc-data')!.textContent || '[]');
  const dlg = document.getElementById('svc-dialog') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  document.querySelectorAll<HTMLElement>('[data-service]').forEach((b) =>
    b.addEventListener('click', () => {
      const s = data.find((x: any) => x.id === b.dataset.service);
      if (!s) return;
      $('svc-title').textContent = s.name;
      $('svc-desc').textContent = s.description;
      const ul = $('svc-points');
      ul.replaceChildren(...s.highlights.map((h: string) => Object.assign(document.createElement('li'), { textContent: '✓ ' + h })));
      ($('svc-wa') as HTMLAnchorElement).href = s.wa;
      dlg.showModal();
    }),
  );
  $('svc-close').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
