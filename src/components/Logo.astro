---
import { Picture } from 'astro:assets';
import full from '../assets/brand/logo-vanascape.png';
import mark from '../assets/brand/logo-mark.png';
import { contact } from '../data/contact';
interface Props { size?: number; /** "mark" = icon only (small sizes), "full" = icon + wordmark */ variant?: 'mark' | 'full'; priority?: boolean; }
const { size = 48, variant = 'mark', priority = false } = Astro.props;
---
<Picture src={variant === 'full' ? full : mark} alt={`${contact.brand} logo`} formats={['avif']} fallbackFormat="webp" widths={[size, size * 2]} sizes={`${size}px`} width={size} height={size} class="rounded-xl bg-[#fbf9f1]" loading={priority ? 'eager' : 'lazy'} />
