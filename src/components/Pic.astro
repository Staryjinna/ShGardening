---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS object-position focal point */
  pos?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Above-the-fold image: eager + high priority */
  priority?: boolean;
}
const { src, alt, pos = '50% 50%', widths = [360, 540, 739], sizes = '(min-width: 1024px) 33vw, 100vw', class: cls = '', priority = false } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['h-full w-full object-cover', cls]}
  style={`object-position:${pos}`}
/>
