---
import Icons from './Icons.astro';
import { waLink, telLink, primaryPhone } from '../lib/links';
---
<section class="on-dark bg-forest-700 text-white">
  <div class="container-x flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center">
    <div>
      <h2 class="h-display text-4xl">Give your garden new life.</h2>
      <p class="mt-2 text-white/85">Message or call us to book a free site visit.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={waLink('Hello Vanascape Gardens, I would like a free site visit.')} target="_blank" rel="noopener" class="btn btn-wa"><Icons name="whatsapp" /> WhatsApp</a>
      <a href={telLink(primaryPhone.digits)} class="btn btn-ghost"><Icons name="phone" /> Call {primaryPhone.display}</a>
    </div>
  </div>
</section>
