---
import Pic from './Pic.astro';
import services from '../assets/photos/modern-stone-slab-driveway.jpg';
import projects from '../assets/photos/lawn-stepping-stones.jpg';
import about from '../assets/photos/traditional-house-garden.jpg';
import contact from '../assets/photos/modern-terrace-planters.jpg';
const tiles = [
  { t: 'Services', d: 'Lawns, stone, pebbles, maintenance', href: '/services/', img: services, pos: '50% 65%' },
  { t: 'Projects', d: 'Browse garden styles', href: '/projects/', img: projects, pos: '50% 60%' },
  { t: 'About', d: 'The owner and how we work', href: '/about/', img: about, pos: '50% 60%' },
  { t: 'Contact', d: 'Call, WhatsApp or enquire', href: '/contact/', img: contact, pos: '50% 55%' },
];
---
<section class="section bg-sand/60" aria-labelledby="explore-h">
  <div class="container-x">
    <p class="eyebrow">Explore</p>
    <h2 id="explore-h" class="h-display mt-2 max-w-2xl text-4xl text-forest-800 sm:text-5xl">Everything in one tap</h2>
    <ul class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
      {tiles.map((t) => (
        <li class="reveal">
          <a href={t.href} class="photo-tile group relative block aspect-[3/4] overflow-hidden rounded-2xl shadow-md">
            <Pic src={t.img} alt="" pos={t.pos} sizes="(min-width: 1024px) 25vw, 50vw" widths={[360, 540, 896]} />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/25 to-transparent transition group-hover:from-forest-900"></div>
            <div class="absolute inset-x-0 bottom-0 p-4 text-white sm:p-5">
              <h3 class="h-display text-3xl">{t.t}</h3>
              <p class="mt-1 text-sm text-white/85">{t.d}</p>
              <span class="mt-3 inline-block text-xs font-semibold uppercase tracking-widest text-sage-300">Open →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
