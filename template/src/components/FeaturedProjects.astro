---
import PhotoGrid from './PhotoGrid.astro';
import { projects } from '../data/projects';
const featured = projects.filter((p) => p.featured);
---
<section id="projects" class="section bg-white">
  <div class="container-x">
    <div class="jaali mb-10" aria-hidden="true"></div>
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Our work</p>
        <h2 class="mt-2 text-3xl font-semibold text-navy-800 sm:text-4xl">Gardens we have built</h2>
      </div>
      <a href="/projects/" class="btn btn-outline self-start sm:self-auto">See all projects</a>
    </div>
    <div class="reveal mt-8"><PhotoGrid items={featured} group="featured" /></div>
  </div>
</section>
