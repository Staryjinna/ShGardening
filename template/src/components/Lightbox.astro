---
import Icons from './Icons.astro';
---
<dialog id="lightbox" class="lb" aria-label="Project photo viewer">
  <button type="button" class="lb-btn right-4 top-4" data-lb-close aria-label="Close photo viewer"><Icons name="close" class="h-6 w-6" /></button>
  <button type="button" class="lb-btn left-3 top-1/2 -translate-y-1/2" data-lb-prev aria-label="Previous photo"><span aria-hidden="true">‹</span></button>
  <button type="button" class="lb-btn right-3 top-1/2 -translate-y-1/2" data-lb-next aria-label="Next photo"><span aria-hidden="true">›</span></button>
  <figure class="flex h-full max-h-full w-full max-w-3xl flex-col items-center justify-center gap-3 px-14 py-6 sm:px-20">
    <img id="lb-img" alt="" class="max-h-[80svh] w-auto max-w-full select-none rounded-lg object-contain" draggable="false" />
    <figcaption id="lb-cap" class="text-center text-sm text-white/90"></figcaption>
  </figure>
</dialog>
<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;
  let list: HTMLElement[] = [];
  let idx = 0;

  const show = (i: number) => {
    idx = (i + list.length) % list.length;
    const el = list[idx];
    img.src = el.dataset.full!;
    img.alt = el.dataset.alt || '';
    cap.textContent = el.dataset.caption || '';
    const next = list[(idx + 1) % list.length];
    if (next) new Image().src = next.dataset.full!;
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
    if (!t) return;
    const group = t.closest('[data-lb-group]')!;
    list = [...group.querySelectorAll<HTMLElement>('[data-lb]')].filter((b) => !b.closest('[hidden]'));
    show(list.indexOf(t));
    dlg.showModal();
  });

  dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  // Click on the dark backdrop closes
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') dlg.close(); });
  dlg.addEventListener('close', () => { img.removeAttribute('src'); });

  // Swipe
  let x0 = 0;
  dlg.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
  dlg.addEventListener('pointerup', (e) => {
    const dx = e.clientX - x0;
    if (Math.abs(dx) > 50 && (e.target as HTMLElement).closest('figure')) show(idx + (dx < 0 ? 1 : -1));
  });
</script>
