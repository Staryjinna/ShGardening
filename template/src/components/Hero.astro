---
import Pic from './Pic.astro';
import Icons from './Icons.astro';
import hero from '../assets/photos/project-courtyard-planter-pergola.jpg';
import { contact } from '../data/contact';
import { waLink, hello } from '../lib/links';
---
<section class="on-dark relative isolate overflow-hidden bg-navy-900 text-white">
  <div class="stone-grid-light absolute inset-0 -z-20" aria-hidden="true"></div>
  <!-- Photo: full-bleed on phones; framed on large screens (source photos are portrait phone captures) -->
  <div class="absolute inset-0 -z-10 lg:inset-y-10 lg:left-auto lg:right-[6%] lg:w-[34%] lg:overflow-hidden lg:rounded-[2rem] lg:shadow-2xl">
    <Pic src={hero} alt="Courtyard garden with a pergola, red jaali wall, granite planter seating and lush tropical plants" pos="50% 58%" widths={[480, 739]} sizes="(min-width: 1024px) 34vw, 100vw" priority />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/55 to-navy-900/10 lg:hidden"></div>
  </div>

  <div class="container-x flex min-h-[min(92svh,820px)] flex-col justify-end pb-14 pt-32 lg:justify-center lg:py-24">
    <div class="max-w-xl lg:max-w-[52%]">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-bold backdrop-blur">
        <Icons name="check" class="h-4 w-4 text-leaf-500" /> {contact.projectsCompleted} projects completed
      </p>
      <h1 class="mt-5 text-4xl font-semibold leading-[1.08] sm:text-5xl lg:text-6xl">Gardens made for {contact.areaServed} homes</h1>
      <p class="mt-5 text-lg text-white/90">Lush lawns, stone pathways, courtyards and year-round garden maintenance, led by {contact.owner}.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={waLink(hello('I would like a free site visit.'))} target="_blank" rel="noopener" class="btn btn-wa"><Icons name="whatsapp" /> WhatsApp for a free site visit</a>
        <a href="/projects/" class="btn btn-ghost">View our work</a>
      </div>
    </div>
  </div>
</section>
