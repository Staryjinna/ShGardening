---
import Icons from './Icons.astro';
import { faqs } from '../data/faq';
---
<section id="faq" class="section">
  <div class="container-x max-w-3xl">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-2 text-3xl font-semibold text-navy-800 sm:text-4xl">Common questions</h2>
    <div class="mt-8 divide-y divide-granite-100 rounded-2xl bg-white ring-1 ring-granite-100">
      {faqs.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-800 [&::-webkit-details-marker]:hidden">
            {f.q}<Icons name="chevron" class="h-6 w-6 shrink-0 transition group-open:rotate-180" />
          </summary>
          <p class="mt-3 text-granite-700">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
